+static bool nova_ahb_scheduler_trace_enabled()
+{
+	const char *value = getenv( "NOVA_AHB_SCHEDULER_TRACE" );
+	return value != nullptr && value[0] == '1';
+}
+
+static unsigned long long nova_ahb_scheduler_monotonic_ns()
+{
+	timespec timestamp = {};
+	if ( clock_gettime( CLOCK_MONOTONIC, &timestamp ) != 0 )
+		return 0;
+	return (unsigned long long)timestamp.tv_sec * 1000000000ULL +
+		(unsigned long long)timestamp.tv_nsec;
+}
+
+static long nova_ahb_scheduler_thread_id()
+{
+	return (long)syscall( SYS_gettid );
+}
+
+static void nova_ahb_scheduler_trace( const char *phase,
+	uint64_t focusCommit, uint64_t overrideCommit, bool vblank,
+	bool hasRepaint, bool hasRepaintNonBasePlane, bool shouldPaint,
+	int flipType, int layerCount, int result )
+{
+	if ( !nova_ahb_scheduler_trace_enabled() )
+		return;
+	xwm_log.infof(
+		"nova_ahb_scheduler_trace monotonic_ns=%llu pid=%d tid=%ld phase=%s focus_commit=%llu override_commit=%llu vblank=%d has_repaint=%d has_repaint_non_base=%d should_paint=%d flip_type=%d layers=%d result=%d",
+		nova_ahb_scheduler_monotonic_ns(), (int)getpid(),
+		nova_ahb_scheduler_thread_id(), phase,
+		(unsigned long long)focusCommit, (unsigned long long)overrideCommit,
+		vblank ? 1 : 0, hasRepaint ? 1 : 0,
+		hasRepaintNonBasePlane ? 1 : 0, shouldPaint ? 1 : 0, flipType,
+		layerCount, result );
+}
 
