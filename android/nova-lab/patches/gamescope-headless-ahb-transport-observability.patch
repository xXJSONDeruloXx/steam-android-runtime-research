+    static void android_socket_register_connection( int index, int fd )
+    {
+        if ( index < 0 || index >= 3 || fd < 0 )
+            return;
+        android_socket_connection_fds[index] = fd;
+        android_socket_connection_generations[index]++;
+        if ( android_socket_connection_generations[index] == 0 )
+            android_socket_connection_generations[index] = 1;
+    }
+
+    static unsigned int android_socket_connection_generation( int index, int fd )
+    {
+        if ( index < 0 || index >= 3 || fd < 0 ||
+             android_socket_connection_fds[index] != fd )
+            return 0;
+        return android_socket_connection_generations[index];
+    }
