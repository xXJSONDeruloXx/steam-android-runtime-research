@@ -52,12 +52,87 @@ namespace gamescope
         const char *value = getenv( "NOVA_AHB_FRAME_COUNT" );
         if ( value == nullptr || value[0] == '\0' )
             return 0;
 
         int frameCount = std::atoi( value );
         return frameCount > 0 && frameCount <= 2000 ? frameCount : 0;
     }
 
+    static bool android_vulkan_readback_enabled()
+    {
+        const char *value = getenv( "NOVA_AHB_VULKAN_READBACK" );
+        return value != nullptr && value[0] == '1';
+    }
+
+    static uint64_t android_vulkan_readback_frame()
+    {
+        const char *value = getenv( "NOVA_AHB_VULKAN_READBACK_FRAME" );
+        if ( value == nullptr || value[0] == '\0' )
+            return 0;
+
+        char *end = nullptr;
+        unsigned long long frame = std::strtoull( value, &end, 10 );
+        return end != value && end != nullptr && end[0] == '\0' && frame <= 2000
+            ? static_cast<uint64_t>( frame ) : 0;
+    }
+
+    static bool android_vulkan_readback_texture( gamescope::Rc<CVulkanTexture> texture,
+        uint64_t *checksum, uint8_t *minChannels, uint8_t *maxChannels,
+        uint8_t *firstPixel, uint8_t *centerPixel, uint8_t *lastPixel )
+    {
+        if ( texture == nullptr || checksum == nullptr || minChannels == nullptr ||
+            maxChannels == nullptr || firstPixel == nullptr || centerPixel == nullptr ||
+            lastPixel == nullptr )
+            return false;
+
+        const uint64_t byteCount = static_cast<uint64_t>( texture->width() ) *
+            static_cast<uint64_t>( texture->height() ) * 4ULL;
+        if ( byteCount == 0 || byteCount > CVulkanDevice::upload_buffer_size )
+            return false;
+
+        auto [mapped, offset] = g_device.uploadBufferData( static_cast<uint32_t>( byteCount ) );
+        auto commandBuffer = g_device.commandBuffer();
+        if ( commandBuffer == nullptr )
+            return false;
+        commandBuffer->copyImageToBuffer( texture, g_device.uploadBuffer(), offset, texture->width() );
+        uint64_t sequence = g_device.submit( std::move( commandBuffer ) );
+        g_device.wait( sequence );
+
+        uint8_t *pixels = static_cast<uint8_t *>( mapped );
+        uint64_t hash = 1469598103934665603ULL;
+        for ( int channel = 0; channel < 4; channel++ )
+        {
+            minChannels[channel] = 255;
+            maxChannels[channel] = 0;
+        }
+        for ( uint32_t row = 0; row < texture->height(); row++ )
+        {
+            uint8_t *line = pixels + static_cast<size_t>( row ) * texture->width() * 4u;
+            for ( uint32_t column = 0; column < texture->width(); column++ )
+            {
+                uint8_t *pixel = line + static_cast<size_t>( column ) * 4u;
+                for ( int channel = 0; channel < 4; channel++ )
+                {
+                    hash ^= pixel[channel];
+                    hash *= 1099511628211ULL;
+                    if ( pixel[channel] < minChannels[channel] )
+                        minChannels[channel] = pixel[channel];
+                    if ( pixel[channel] > maxChannels[channel] )
+                        maxChannels[channel] = pixel[channel];
+                }
+            }
+        }
+
+        const size_t centerOffset =
+            ( static_cast<size_t>( texture->height() / 2 ) * texture->width() +
+            static_cast<size_t>( texture->width() / 2 ) ) * 4u;
+        memcpy( firstPixel, pixels, 4u );
+        memcpy( centerPixel, pixels + centerOffset, 4u );
+        memcpy( lastPixel, pixels + byteCount - 4u, 4u );
+        *checksum = hash;
+        return true;
+    }
