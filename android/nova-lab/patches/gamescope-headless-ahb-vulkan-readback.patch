+void CVulkanCmdBuffer::copyImageToBuffer(gamescope::Rc<CVulkanTexture> src, VkBuffer buffer, VkDeviceSize offset, uint32_t rowLength)
+{
+	prepareSrcImage(src.get());
+	insertBarrier();
+
+	VkBufferImageCopy region = {
+		.bufferOffset = offset,
+		.bufferRowLength = rowLength,
+		.bufferImageHeight = 0,
+		.imageSubresource = {
+			.aspectMask = VK_IMAGE_ASPECT_COLOR_BIT,
+			.layerCount = 1,
+		},
+		.imageOffset = { 0, 0, 0 },
+		.imageExtent = {
+			src->width(),
+			src->height(),
+			1,
+		},
+	};
+
+	m_device->vk.CmdCopyImageToBuffer(m_cmdBuffer, src->vkImage(), VK_IMAGE_LAYOUT_GENERAL, buffer, 1, &region);
+
+	m_textureRefs.emplace_back(std::move(src));
+}
