+int vulkan_export_signaled_fence()
+{
+	VkExportSemaphoreCreateInfo exportInfo = {
+		.sType = VK_STRUCTURE_TYPE_EXPORT_SEMAPHORE_CREATE_INFO,
+		.handleTypes = VK_EXTERNAL_SEMAPHORE_HANDLE_TYPE_SYNC_FD_BIT,
+	};
+	VkSemaphoreCreateInfo semaphoreInfo = {
+		.sType = VK_STRUCTURE_TYPE_SEMAPHORE_CREATE_INFO,
+		.pNext = &exportInfo,
+	};
+	VkSemaphore semaphore = VK_NULL_HANDLE;
+	VkResult result = g_device.vk.CreateSemaphore(
+		g_device.device(), &semaphoreInfo, nullptr, &semaphore);
+	if ( result != VK_SUCCESS )
+	{
+		vk_errorf( result, "vkCreateSemaphore for Android acquire fence failed" );
+		return -1;
+	}
+
+	VkSubmitInfo submitInfo = {
+		.sType = VK_STRUCTURE_TYPE_SUBMIT_INFO,
+		.signalSemaphoreCount = 1,
+		.pSignalSemaphores = &semaphore,
+	};
+	result = g_device.vk.QueueSubmit( g_device.queue(), 1, &submitInfo, VK_NULL_HANDLE );
+	if ( result != VK_SUCCESS )
+	{
+		vk_errorf( result, "vkQueueSubmit for Android acquire fence failed" );
+		g_device.vk.DestroySemaphore( g_device.device(), semaphore, nullptr );
+		return -1;
+	}
+
+	VkSemaphoreGetFdInfoKHR fdInfo = {
+		.sType = VK_STRUCTURE_TYPE_SEMAPHORE_GET_FD_INFO_KHR,
+		.semaphore = semaphore,
+		.handleType = VK_EXTERNAL_SEMAPHORE_HANDLE_TYPE_SYNC_FD_BIT,
+	};
+	int fenceFd = -1;
+	result = g_device.vk.GetSemaphoreFdKHR( g_device.device(), &fdInfo, &fenceFd );
+	g_device.vk.DestroySemaphore( g_device.device(), semaphore, nullptr );
+	if ( result != VK_SUCCESS )
+	{
+		vk_errorf( result, "vkGetSemaphoreFdKHR for Android acquire fence failed" );
+		return -1;
+	}
+
+	return fenceFd;
+}
