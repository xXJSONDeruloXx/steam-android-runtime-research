+    static bool send_android_ack( int connection, int acquireFenceFd,
+        uint64_t frame, int index )
+    {
+        static constexpr char acknowledgement[] =
+            "linux_import=pass linux_gpu_write=pass linux_image_write=pass linux_acquire_fence=pass linux_loop=pass\n";
+        iovec vector = {
+            .iov_base = const_cast<char *>( acknowledgement ),
+            .iov_len = sizeof( acknowledgement ) - 1,
+        };
+        char control[CMSG_SPACE( sizeof( int ) )] = {};
+        msghdr message = {
+            .msg_iov = &vector,
+            .msg_iovlen = 1,
+        };
+        message.msg_control = control;
+        message.msg_controllen = sizeof( control );
+        cmsghdr *header = CMSG_FIRSTHDR( &message );
+        header->cmsg_level = SOL_SOCKET;
+        header->cmsg_type = SCM_RIGHTS;
+        header->cmsg_len = CMSG_LEN( sizeof( acquireFenceFd ) );
+        memcpy( CMSG_DATA( header ), &acquireFenceFd, sizeof( acquireFenceFd ) );
+
+        errno = 0;
+        ssize_t sent = sendmsg( connection, &message, MSG_NOSIGNAL );
+        int errorNumber = sent < 0 ? errno : 0;
+        android_socket_trace( "ack_send", frame, index, connection, sent,
+            errorNumber, &message, acquireFenceFd, acknowledgement );
+        close( acquireFenceFd );
+        return sent == static_cast<ssize_t>( sizeof( acknowledgement ) - 1 );
+    }
