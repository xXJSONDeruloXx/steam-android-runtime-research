+    static int receive_android_handle( int connection )
+    {
+        char payload[256] = {};
+        char control[CMSG_SPACE( sizeof( int ) * 16 )] = {};
+        iovec vector = {
+            .iov_base = payload,
+            .iov_len = sizeof( payload ),
+        };
+        msghdr message = {
+            .msg_iov = &vector,
+            .msg_iovlen = 1,
+            .msg_control = control,
+            .msg_controllen = sizeof( control ),
+        };
+
+        ssize_t received = recvmsg( connection, &message, 0 );
+        if ( received < 0 )
+        {
+            headless_log.errorf_errno( "recv Android output handle failed" );
+            return -1;
+        }
+
+        int receivedFd = -1;
+        for ( cmsghdr *header = CMSG_FIRSTHDR( &message ); header != nullptr; header = CMSG_NXTHDR( &message, header ) )
+        {
+            if ( header->cmsg_level != SOL_SOCKET || header->cmsg_type != SCM_RIGHTS )
+                continue;
+
+            size_t descriptorCount = ( header->cmsg_len - CMSG_LEN( 0 ) ) / sizeof( int );
+            int *descriptors = reinterpret_cast<int *>( CMSG_DATA( header ) );
+            for ( size_t i = 0; i < descriptorCount; i++ )
+            {
+                if ( receivedFd < 0 )
+                    receivedFd = descriptors[i];
+                else
+                    close( descriptors[i] );
+            }
+        }
+
+        if ( received <= 0 || receivedFd < 0 )
+        {
+            if ( receivedFd >= 0 )
+                close( receivedFd );
+            headless_log.errorf( "Android output handle message had no DMA-BUF FD" );
+            return -1;
+        }
+
+        return receivedFd;
+    }
