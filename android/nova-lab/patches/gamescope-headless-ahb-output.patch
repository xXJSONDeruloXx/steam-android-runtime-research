+    static int connect_android_socket( const char *path )
+    {
+        if ( path == nullptr || strlen( path ) >= sizeof( ( (sockaddr_un *)nullptr )->sun_path ) )
+            return -1;
+
+        sockaddr_un address = {
+            .sun_family = AF_UNIX,
+        };
+        strcpy( address.sun_path, path );
+
+        int lastErrno = ENOENT;
+        for ( int attempt = 0; attempt < 150; attempt++ )
+        {
+            int fd = socket( AF_UNIX, SOCK_STREAM | SOCK_CLOEXEC, 0 );
+            if ( fd >= 0 && connect( fd, reinterpret_cast<sockaddr *>( &address ), sizeof( address ) ) == 0 )
+                return fd;
+
+            lastErrno = errno;
+            if ( fd >= 0 )
+                close( fd );
+            if ( lastErrno != ENOENT && lastErrno != ECONNREFUSED )
+                break;
+
+            usleep( 100000 );
+        }
+
+        errno = lastErrno;
+        headless_log.errorf_errno( "connect Android output socket failed" );
+        return -1;
+    }
