+        {
+            headless_log.errorf( "Android release message wait failed buffer %d poll=%d revents=0x%x errno=%d",
+                expectedBuffer, pollResult, socketPoll.revents, errno );
+            return false;
+        }
+
+        char payload[128] = {};
+        char control[CMSG_SPACE( sizeof( int ) * 4 )] = {};
+        iovec vector = {
+            .iov_base = payload,
+            .iov_len = sizeof( payload ) - 1,
+        };
+        msghdr message = {
+            .msg_iov = &vector,
+            .msg_iovlen = 1,
+            .msg_control = control,
+            .msg_controllen = sizeof( control ),
+        };
+        errno = 0;
+        ssize_t received = recvmsg( connection, &message, 0 );
+        int receiveError = received < 0 ? errno : 0;
+        int releaseFenceFd = -1;
+        for ( cmsghdr *header = CMSG_FIRSTHDR( &message ); header != nullptr; header = CMSG_NXTHDR( &message, header ) )
+        {
+            if ( header->cmsg_level != SOL_SOCKET || header->cmsg_type != SCM_RIGHTS )
+                continue;
+
+            size_t descriptorCount = ( header->cmsg_len - CMSG_LEN( 0 ) ) / sizeof( int );
+            int *descriptors = reinterpret_cast<int *>( CMSG_DATA( header ) );
+            for ( size_t i = 0; i < descriptorCount; i++ )
+            {
+                if ( releaseFenceFd < 0 )
+                    releaseFenceFd = descriptors[i];
+                else
+                    close( descriptors[i] );
+            }
+        }
+        android_socket_trace( "release_recv", frame, expectedBuffer,
+            connection, received, receiveError, &message, releaseFenceFd,
+            payload );
+
+        char expectedMessage[32];
+        snprintf( expectedMessage, sizeof( expectedMessage ), "release_buffer=%d", expectedBuffer );
+        bool validMessage = received > 0 && strstr( payload, expectedMessage ) != nullptr && releaseFenceFd >= 0;
+        if ( !validMessage )
+        {
+            headless_log.errorf( "Android release message invalid buffer %d bytes=%zd fd=%d payload=%s",
+                expectedBuffer, received, releaseFenceFd, payload );
+            if ( releaseFenceFd >= 0 )
