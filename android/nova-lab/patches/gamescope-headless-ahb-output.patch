+
+        pollfd fencePoll = {
+            .fd = releaseFenceFd,
+            .events = POLLIN,
+        };
+        errno = 0;
+        do
+        {
+            pollResult = poll( &fencePoll, 1, 5000 );
+        } while ( pollResult < 0 && errno == EINTR );
+        pollError = pollResult < 0 ? errno : 0;
