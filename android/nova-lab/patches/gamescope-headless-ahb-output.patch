+        android_socket_trace( "handle_recv", 0, -1, connection, received,
+            errorNumber, &message, receivedFd, nullptr );
+        if ( received <= 0 || receivedFd < 0 )
+        {
+            if ( receivedFd >= 0 )
+                close( receivedFd );
+            headless_log.errorf( "Android output handle message had no DMA-BUF FD" );
+            return -1;
+        }
+
+        return receivedFd;
+    }
